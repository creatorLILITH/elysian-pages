# Supabase (browser + server). The browser client inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only, service role) - used by upload/delete route handlers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (server only) - used by the pg Pool for the legacy auth/books routes.
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# Deepgram text-to-speech (server only). /api/tts proxies to Deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=flux-hannah-en
DEEPGRAM_TTS_SPEED=1
